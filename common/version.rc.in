#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SMPD_FILEVERSION_COMMA@
 PRODUCTVERSION @SMPD_FILEVERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "InternalName", "@SMPD_RC_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@SMPD_RC_ORIGINAL_FILENAME@\0"
            VALUE "FileDescription", "@SMPD_RC_FILEDESCRIPTION@\0"
            VALUE "ProductVersion", "@SMPD_PRODUCT_VERSION@\0"
            VALUE "FileVersion", "@SMPD_PRODUCT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
